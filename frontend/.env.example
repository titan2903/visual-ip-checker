# ==============================================================================
# TARUM FRONTEND CONFIGURATION (.env.example)
# ==============================================================================

# URL Base API Backend
# Default kosong "" akan menggunakan proxy internal Vite (/api)
VITE_API_BASE_URL=

# Judul Aplikasi & Branding
VITE_APP_TITLE=Tarum — Visual IP Screening

# Batasan Ukuran Upload Gambar (Megabytes)
VITE_MAX_UPLOAD_SIZE_MB=5

# Link Portal Pangkalan Data Kekayaan Intelektual (PDKI Resmi)
VITE_PDKI_URL=https://pdki-indonesia.dgip.go.id