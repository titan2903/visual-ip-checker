# ==============================================================================
# TARUM BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Model Pretrained CLIP (via sentence-transformers)
TARUM_MODEL_NAME=clip-ViT-B-32

# Dataset Hugging Face Referensi Batik (PRD Section 7.1)
TARUM_HF_DATASET=muhammadsalmanalfaridzi/Batik-Indonesia

# Server Network Binding
TARUM_HOST=0.0.0.0
TARUM_PORT=8000

# CORS Allowed Origins (pisahkan dengan tanda koma)
TARUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,*

# Lokasi Direktori Data (opsional, default: backend/data)
# TARUM_DATA_DIR=backend/data

# Batasan Upload File (Maksimal dalam Megabytes)
TARUM_MAX_UPLOAD_SIZE_MB=5.0

# Jumlah Hasil Pembanding Teratas (Top-K)
TARUM_DEFAULT_TOP_K=5

# Batas Ambang Kategori Risiko Kemiripan (%)
TARUM_RISK_THRESHOLD_LOW=50.0
TARUM_RISK_THRESHOLD_HIGH=75.0
